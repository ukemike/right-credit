{
  "name": "@right-credit/under-writing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/under-writing/src",
  "tags": ["scope:app", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{projectRoot}/.next"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/under-writing"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/under-writing"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:dev",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "@right-credit/under-writing:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "@right-credit/under-writing:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "@right-credit/under-writing:build:production",
          "dev": false
        }
      }
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "@right-credit/under-writing:build:production"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/under-writing/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverageReporters": ["text"]
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/under-writing/**/*.{ts,tsx,js,jsx}"]
      }
    }
  }
}
